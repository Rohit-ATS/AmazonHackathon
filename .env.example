# CareFlow configuration. Copy to .env and fill in what you have.
# Everything here is optional: with no values at all, `npm run dev:api` runs the full demo
# locally using a local JSON store, browser speech, and the scripted orchestrator.

# ---------------------------------------------------------------------------
# Ring Partner API (Rohit)
# ---------------------------------------------------------------------------
# From the Amazon Developer Portal -> Ring -> your app. Staging credentials are fine.
# RING_CLIENT_ID=
# RING_CLIENT_SECRET=
# Partner HMAC key. Ring signs every webhook with this; we verify every delivery against
# it, and the simulator signs with it too, so local runs exercise the same code path.
# Leave unset locally and a dev key is used instead.
# RING_HMAC_KEY=
# RING_REDIRECT_URI=http://localhost:8787/ring/oauth/callback

# ---------------------------------------------------------------------------
# AWS (Rohit for storage/voice, Damir for Bedrock)
# ---------------------------------------------------------------------------
# AWS_REGION=us-east-1
# Set CAREFLOW_TABLE to switch from the local JSON store to DynamoDB.
# CAREFLOW_TABLE=careflow
# Bedrock model id. List what your account can actually call with:
#   aws bedrock list-foundation-models --query "modelSummaries[].modelId" --output table
# Cross-region inference profiles are prefixed, e.g. us.anthropic.<model>.
# BEDROCK_MODEL_ID=
# Amazon Polly voice. Unset or CAREFLOW_TTS=browser uses browser speech synthesis instead.
# CAREFLOW_TTS=polly
# POLLY_VOICE_ID=Joanna

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# PORT=8787
# Public base URL of this API. The demo controls POST signed Ring payloads to it, so it has
# to be reachable from the server itself.
# CAREFLOW_SELF_URL=http://localhost:8787
# Demo mode records notifications instead of sending them. Keep it on for the hackathon.
# CAREFLOW_DEMO_MODE=true
# Demo anchoring puts today's scheduled visit around "now" so the timeline reads coherently
# whenever the video is recorded. Set false to use the fixture's fixed clock times.
# CAREFLOW_DEMO_ANCHOR=true
